# Password richiesta per accedere all'applicazione.
APP_PASSWORD=inserisci-una-password-sicura

# Password separata richiesta per scaricare o sostituire la checklist Excel.
ADMIN_PASSWORD=inserisci-una-password-amministratore-diversa

# Segreto casuale consigliato per firmare le sessioni (almeno 32 caratteri).
# Se omesso, viene usata APP_PASSWORD.
APP_SESSION_SECRET=inserisci-un-segreto-casuale-lungo

# Redis Upstash: usato per rate limiting e persistenza della checklist caricata.
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
